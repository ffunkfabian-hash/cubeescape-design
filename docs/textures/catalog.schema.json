{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cubeescape-design/texture-catalog",
  "title": "cubeescape-design/texture-catalog v1",
  "type": "object",
  "required": ["format", "format_version", "units", "materials", "patterns", "finishes", "skins", "channels"],
  "properties": {
    "format": {"const": "cubeescape-design/texture-catalog"},
    "format_version": {"const": 1},
    "units": {"type": "object", "required": ["length", "model_unit_m", "axes"],
      "properties": {"length": {"const": "mm"}, "model_unit_m": {"type": "number", "exclusiveMinimum": 0}, "axes": {"type": "object"}}},
    "materials": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/material"}},
    "patterns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pattern"}},
    "finishes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finish"}},
    "wear": {"$ref": "#/$defs/wear"},
    "skins": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/skin"}},
    "glyphs": {"type": "object", "required": ["digits", "segments", "runes", "slant", "thickness"]},
    "channels": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/channel"}}}},
    "swatch_setup": {"type": "object", "required": ["size", "palette", "lighting", "mock"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "slot": {"type": "string", "pattern": "^(MT_(Primary|Secondary|Accent|Metal|Energy|Emission|Detail)|SK_Accent[12])$"},
    "text": {"type": "object", "required": ["de", "en"], "properties": {"de": {"type": "string"}, "en": {"type": "string"}}},
    "swatch": {"type": ["string", "null"], "pattern": "^swatches/[a-z0-9_]+\\.png$"},
    "material": {"type": "object", "required": ["id", "name", "toolgen_material", "pattern", "channels", "sheet_pattern", "swatch"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}, "toolgen_material": {"$ref": "#/$defs/id"},
        "aliases": {"type": "object", "additionalProperties": {"type": "string"}},
        "pattern": {"type": ["string", "null"]}, "finish": {"type": ["string", "null"]},
        "channels": {"type": "array", "items": {"$ref": "#/$defs/slot"}}, "sheet_pattern": {"type": "boolean"}, "swatch": {"$ref": "#/$defs/swatch"}}},
    "pattern": {"type": "object", "required": ["id", "name", "toolgen_pattern", "used_by_sheets", "size_mm", "direction", "height_mm", "contrast", "params"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"},
        "toolgen_pattern": {"enum": ["knurl", "grooves", "lamellae", "seams", "brushed", "grain", null]},
        "used_by_sheets": {"type": "boolean"}, "size_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "direction": {"type": ["string", "null"]}, "height_mm": {"type": ["number", "null"], "minimum": 0, "maximum": 0.3},
        "contrast": {"type": ["object", "null"]}, "params": {"type": "object"}}},
    "finish": {"type": "object", "required": ["id", "name", "ladder", "streak", "emissive", "swatch", "swatch_color"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}, "streak": {"type": "boolean"}, "emissive": {"type": "boolean"},
        "swatch": {"$ref": "#/$defs/swatch"}, "swatch_color": {"$ref": "#/$defs/color"},
        "ladder": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["levels", "blends"]},
          "levels": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "exclusiveMinimum": 0}}}}}},
    "wear": {"type": "object", "required": ["levels", "bare_metal", "streak", "swatch"],
      "properties": {"bare_metal": {"$ref": "#/$defs/color"}, "swatch": {"$ref": "#/$defs/swatch"},
        "levels": {"type": "object", "required": ["subtle", "medium", "strong"], "additionalProperties": {"type": "object", "required": ["toolgen", "width_rel", "coverage"],
          "properties": {"toolgen": {"type": "number", "minimum": 0, "maximum": 1}, "width_rel": {"type": "number", "exclusiveMinimum": 0}, "coverage": {"type": "number", "minimum": 0, "maximum": 1}}}}}},
    "skin": {"type": "object", "required": ["id", "name", "origin", "description", "blocks", "accents", "layers", "rules", "swatch"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}, "origin": {"enum": ["claude", "codex"]},
        "description": {"$ref": "#/$defs/text"}, "swatch": {"$ref": "#/$defs/swatch"},
        "blocks": {"type": "array", "minItems": 1, "items": {"enum": ["farbflaechen", "glyphen", "streifen", "material", "schmuck"]}},
        "accents": {"type": "object", "required": ["SK_Accent1", "SK_Accent2"], "additionalProperties": {"type": "object", "required": ["color", "finish"],
          "properties": {"color": {"$ref": "#/$defs/color"}, "finish": {"$ref": "#/$defs/id"}}}},
        "layers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type", "block"],
          "properties": {"type": {"enum": ["side_block", "bands", "gradient", "rings", "glyphs", "finish", "edge_wear", "trim", "region", "blend"]},
            "block": {"enum": ["farbflaechen", "glyphen", "streifen", "material", "schmuck"]}}}},
        "rules": {"type": "object"}}}
    ,
    "channel": {"type": "object", "required": ["id", "role", "material", "follows_variant"],
      "properties": {"id": {"$ref": "#/$defs/slot"}, "role": {"$ref": "#/$defs/text"}, "material": {"type": ["string", "null"]}, "follows_variant": {"type": "boolean"}}}
  }
}
