{
  "name": "cubeescape-design",
  "version": {
    "file": "CHANGELOG.md",
    "pattern": "(?m)^## claude-(\\d+\\.\\d+(?:\\.\\d+)?)"
  },
  "check": {
    "quick": [["python3", "-m", "py_compile", "claude/generator/eng.py", "claude/generator/raster.py", "claude/generator/views.py", "claude/generator/xl.py",
               "claude/generator/xlroles.py", "claude/generator/sheetmodels.py", "claude/generator/export_spec.py",
               "claude/generator/skins.py", "claude/generator/skinraster.py", "claude/generator/variants.py", "claude/generator/jlib.py",
               "claude/generator/new_variant.py", "claude/generator/spec_checks.py", "claude/generator/vsmodels.py",
               "claude/generator/export_sight.py", "claude/generator/vsheet.py", "claude/generator/build_vs.py"],
              ["python3", "claude/generator/test_spec.py"],
              ["python3", "claude/generator/export_sight.py", "--check"],
              ["python3", "claude/generator/test_sight_spec.py"],
              ["python3", "claude/tests/test_golden.py"]],
    "full": [["python3", "claude/generator/build_all.py", "--nur-xl"],
             ["python3", "claude/tests/test_golden.py", "--full"]]
  },
  "docs": {
    "changelog": "CHANGELOG.md",
    "dir": "claude/docs"
  },
  "owners": {
    "claude/": "Claude",
    "codex/": "Codex",
    "docs/": "gemeinsam – nur auf Wunsch des Nutzers",
    "Wurzel (README.md, CHANGELOG.md, AGENTS.md, CLAUDE.md, .ce-repo.json, .github/)": "Claude; Codex meldet Änderungswünsche"
  },
  "release": {
    "branch_prefix": "release/",
    "tag_prefix": "claude-v",
    "note": "Release per Branch release/claude-<version>"
  },
  "heavy_lock": true
}
