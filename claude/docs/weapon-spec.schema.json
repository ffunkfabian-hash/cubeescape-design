{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "cubeescape-design/weapon-spec/1",
 "title": "Weapon spec der Konzeptblätter (format_version 1)",
 "description": "Beschreibung: claude/docs/weapon-spec.md. Erzeugt von claude/generator/export_spec.py; geprüft von claude/generator/test_spec.py (eigene Teilmenge von JSON Schema: type, required, properties, items, enum, const, pattern, minimum, minItems, maxItems, additionalProperties false).",
 "$defs": {
  "hex": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
  "hexOrNull": {"type": ["string", "null"], "pattern": "^#[0-9A-F]{6}$"},
  "channel": {"enum": ["MT_Primary", "MT_Secondary", "MT_Accent", "MT_Metal", "MT_Energy", "MT_Emission", "MT_Detail"]},
  "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
  "vec3OrNull": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
  "bounds": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 2, "maxItems": 2},
  "dims": {
   "type": "object", "required": ["length", "height", "width", "bounds_m"],
   "properties": {"length": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0},
                  "width": {"type": "number", "minimum": 0}, "bounds_m": {"$ref": "#/$defs/bounds"}}
  },
  "anchor": {
   "type": "object", "required": ["position_m", "model", "source"],
   "properties": {"position_m": {"$ref": "#/$defs/vec3OrNull"}, "model": {"$ref": "#/$defs/vec3OrNull"}, "source": {"type": "string"}}
  },
  "channels": {
   "type": "object",
   "required": ["MT_Primary", "MT_Secondary", "MT_Accent", "MT_Metal", "MT_Energy", "MT_Emission", "MT_Detail"],
   "additionalProperties": false,
   "properties": {
    "MT_Primary": {"$ref": "#/$defs/hexOrNull"}, "MT_Secondary": {"$ref": "#/$defs/hexOrNull"},
    "MT_Accent": {"$ref": "#/$defs/hexOrNull"}, "MT_Metal": {"$ref": "#/$defs/hexOrNull"},
    "MT_Energy": {"$ref": "#/$defs/hexOrNull"}, "MT_Emission": {"$ref": "#/$defs/hexOrNull"},
    "MT_Detail": {"$ref": "#/$defs/hexOrNull"}
   }
  }
 },
 "type": "object",
 "required": ["format", "format_version", "generator", "sheet", "weapon", "element", "element_source", "units", "axes",
              "dimensions_m", "anchors", "palette", "channels_used", "parts", "sight", "decals", "textures", "summary"],
 "properties": {
  "format": {"const": "cubeescape-design/weapon-spec"},
  "format_version": {"const": 1},
  "generator": {"type": "object", "required": ["repo", "tool", "claude_version"]},
  "sheet": {
   "type": "object", "required": ["id", "file", "variant", "number", "nick", "fid"],
   "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}, "variant": {"type": "string"},
                  "number": {"type": "string"}, "file": {"type": "string"}, "nick": {"type": "string"}, "fid": {"type": "string"}}
  },
  "weapon": {
   "type": "object", "required": ["name_de", "toolgen_id"],
   "properties": {"toolgen_id": {"enum": ["pistol", "assault_rifle", "pulse_rifle", "shotgun", "sniper_rifle", "smg", "fusion_rifle", "scout_rifle", "rocket_launcher", "bow"]}}
  },
  "element": {"enum": ["solar", "arc", "void", "energy", null]},
  "element_source": {"type": "string"},
  "units": {
   "type": "object", "required": ["model_unit_m", "model_length_units", "reference_length_m", "rule", "reference"],
   "properties": {"model_unit_m": {"type": "number", "minimum": 0}, "model_length_units": {"type": "number", "minimum": 0},
                  "reference_length_m": {"type": "number", "minimum": 0}}
  },
  "axes": {
   "type": "object", "required": ["model", "target", "matrix_model_to_target", "origin", "formula"],
   "properties": {"origin": {"const": "Socket_Hand"},
                  "matrix_model_to_target": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 3, "maxItems": 3}}
  },
  "dimensions_m": {
   "type": "object", "required": ["weapon", "with_sight"],
   "properties": {"weapon": {"$ref": "#/$defs/dims"}, "with_sight": {"$ref": "#/$defs/dims"}}
  },
  "anchors": {
   "type": "object",
   "required": ["Socket_Hand", "Socket_SupportHand", "Socket_Muzzle", "Socket_CenterOfMass", "Socket_Sight"],
   "additionalProperties": false,
   "properties": {
    "Socket_Hand": {"$ref": "#/$defs/anchor"}, "Socket_SupportHand": {"$ref": "#/$defs/anchor"},
    "Socket_Muzzle": {"$ref": "#/$defs/anchor"}, "Socket_CenterOfMass": {"$ref": "#/$defs/anchor"},
    "Socket_Sight": {"$ref": "#/$defs/anchor"}
   }
  },
  "palette": {
   "type": "array", "minItems": 4, "maxItems": 4,
   "items": {
    "type": "object", "required": ["id", "name", "swatches", "channels", "other_colors", "on_sheet", "sight_colors"],
    "properties": {
     "id": {"enum": ["base", "standard", "arktis", "nacht"]},
     "name": {"type": "string"},
     "swatches": {"type": "array", "items": {"$ref": "#/$defs/hex"}, "minItems": 4, "maxItems": 4},
     "channels": {"$ref": "#/$defs/channels"},
     "other_colors": {"type": "object"},
     "on_sheet": {"type": "boolean"},
     "sight_colors": {"enum": ["wie Modell", "extrapoliert"]}
    }
   }
  },
  "channels_used": {"type": "array", "items": {"$ref": "#/$defs/channel"}},
  "parts": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "label", "channel", "channel_source", "material", "emissive", "sight", "color", "area_m2", "long_axis", "bounds_m"],
    "properties": {
     "id": {"type": "string", "pattern": "^p[0-9]{2,3}$"},
     "label": {"type": ["string", "null"]},
     "channel": {"$ref": "#/$defs/channel"},
     "channel_source": {"enum": ["explicit", "role", "distributed"]},
     "material": {"enum": ["painted", "brushed", "rubber", "matte", "lit"]},
     "emissive": {"type": "boolean"}, "sight": {"type": "boolean"},
     "color": {"$ref": "#/$defs/hex"},
     "area_m2": {"type": "number", "minimum": 0},
     "long_axis": {"enum": ["X", "Y", "Z"]},
     "bounds_m": {"$ref": "#/$defs/bounds"}
    }
   }
  },
  "sight": {
   "type": "object", "required": ["present", "kind", "window", "source", "modular", "mount_side", "labels", "parts", "bounds_m", "anchor"],
   "properties": {
    "present": {"type": "boolean"},
    "kind": {"enum": ["iron", "reflex", "holo", "scope", "energy", "pin", null]},
    "window": {"enum": ["none", "open", "glass", "lens", null]},
    "mount_side": {"enum": ["top", "left", "right", null]},
    "labels": {"type": "array", "items": {"type": "string"}},
    "parts": {"type": "array", "items": {"type": "string"}}
   }
  },
  "decals": {
   "type": "array",
   "items": {
    "type": "object", "required": ["part", "channel", "surface", "emissive", "color", "area_m2", "bounds_m"],
    "properties": {
     "part": {"type": "string", "pattern": "^p[0-9]{2,3}$"},
     "channel": {"$ref": "#/$defs/channel"},
     "surface": {"enum": ["left", "right", "front", "back", "top", "bottom"]},
     "emissive": {"type": "boolean"},
     "color": {"$ref": "#/$defs/hex"},
     "area_m2": {"type": "number", "minimum": 0},
     "bounds_m": {"$ref": "#/$defs/bounds"}
    }
   }
  },
  "textures": {
   "type": "object", "required": ["source", "vocabulary", "painted", "brushed", "rubber", "matte", "lit"]
  },
  "summary": {"type": "object", "required": ["parts", "parts_explicit_channel", "decals", "channels_with_other_colors"]}
 }
}
