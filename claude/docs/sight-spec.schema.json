{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/ffunkfabian-hash/cubeescape-design/claude/docs/sight-spec.schema.json",
 "title": "cubeescape-design/sight-spec, format_version 1",
 "description": "Beschreibung: claude/docs/sight-spec.md. Erzeugt von claude/generator/export_sight.py aus claude/generator/vsmodels.py; geprüft von claude/generator/test_sight_spec.py (Teilmenge von JSON Schema wie beim Weapon-Spec: type, required, properties, items, enum, const, pattern, minimum, minItems, maxItems, additionalProperties nur, wenn gesetzt). Unbekannte Felder sind erlaubt (Erweiterung innerhalb format_version 1). Rahmen: Blender, vorn −Y, oben +Z, links +X, Meter, Ursprung Socket_Mount.",
 "$defs": {
  "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
  "bounds": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 2, "maxItems": 2},
  "hex": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
  "channel": {"enum": ["MT_Primary", "MT_Secondary", "MT_Accent", "MT_Metal", "MT_Energy", "MT_Emission", "MT_Detail"]},
  "type": {"enum": ["standard", "holo", "precision", "reflex", "sniper", "machine", "energy", "trace", "rocket"]},
  "frame": {"enum": ["standard", "compact", "open", "closed", "industrial", "lightweight"]},
  "tint": {"enum": ["clear", "light", "blue", "orange", "red", "green", "purple", "mirror"]},
  "anchor": {
   "type": "object",
   "required": ["position_m", "forward", "up", "local_forward", "local_up", "rotation_euler_deg", "source"],
   "properties": {
    "position_m": {"$ref": "#/$defs/vec3"},
    "forward": {"const": [0.0, -1.0, 0.0]},
    "up": {"const": [0.0, 0.0, 1.0]},
    "local_forward": {"const": "+Z"},
    "local_up": {"const": "+Y"},
    "rotation_euler_deg": {"const": [90.0, 0.0, 0.0]},
    "source": {"type": "string"}
   }
  }
 },
 "type": "object",
 "required": ["format", "format_version", "generator", "sheet", "weapon", "sight", "axes", "dimensions_m", "window", "frame", "glass_tint",
              "glass", "tube", "module", "anchors", "sight_line", "window_geometry", "parts", "reticle_variants", "reticle_color", "variants", "source"],
 "properties": {
  "format": {"const": "cubeescape-design/sight-spec"},
  "format_version": {"const": 1},
  "generator": {"type": "object", "required": ["repo", "tool", "claude_version", "model"]},
  "sheet": {"type": "object", "required": ["id", "file", "series", "number"],
            "properties": {"id": {"type": "string", "pattern": "^VS0[1-9]$"}, "series": {"const": "VS"}, "file": {"type": "string", "pattern": "^VS0[1-9]\\.dc\\.html$"}}},
  "weapon": {"type": "object", "required": ["number", "name_de", "toolgen_id", "weapon_spec"],
             "properties": {"number": {"type": "integer", "minimum": 1},
                            "toolgen_id": {"enum": ["pistol", "assault_rifle", "pulse_rifle", "shotgun", "sniper_rifle", "smg", "fusion_rifle", "scout_rifle", "rocket_launcher"]},
                            "weapon_spec": {"type": "object", "required": ["format", "match", "sheets"],
                                            "properties": {"format": {"const": "cubeescape-design/weapon-spec"}, "match": {"const": "weapon.toolgen_id"},
                                                           "sheets": {"type": "array", "items": {"type": "string", "pattern": "^K[A-Z][0-9]{2}$"}, "minItems": 1}}}}},
  "sight": {"type": "object", "required": ["type", "kind", "window_kind", "frame", "modular"],
            "properties": {"type": {"$ref": "#/$defs/type"}, "kind": {"enum": ["reflex", "holo", "scope", "energy"]},
                           "window_kind": {"enum": ["glass", "lens"]}, "frame": {"$ref": "#/$defs/frame"}, "modular": {"const": true}}},
  "axes": {"type": "object", "required": ["target", "matrix_model_to_target", "model_unit_m", "origin"],
           "properties": {"origin": {"const": "Socket_Mount"}, "matrix_model_to_target": {"const": [[0, 0, 1], [-1, 0, 0], [0, -1, 0]]}}},
  "dimensions_m": {"type": "object", "required": ["length", "height", "width", "bounds_m", "line_height_m"],
                   "properties": {"bounds_m": {"$ref": "#/$defs/bounds"}, "length": {"type": "number", "minimum": 0}, "line_height_m": {"type": "number", "minimum": 0}}},
  "window": {"type": "object", "required": ["shape", "width_m", "height_m", "center_m", "view_axis_m", "free", "aperture"],
             "properties": {"shape": {"enum": ["rect", "round", "octagon"]}, "width_m": {"type": "number", "minimum": 0}, "height_m": {"type": "number", "minimum": 0},
                            "center_m": {"$ref": "#/$defs/vec3"}, "view_axis_m": {"const": [0.0, -1.0, 0.0]}, "free": {"const": true},
                            "aperture": {"type": "object", "required": ["rays", "blocked_by"], "properties": {"blocked_by": {"type": "array", "maxItems": 0}}}}},
  "frame": {"type": "object", "required": ["type", "name_de", "parts", "outer_width_m", "outer_height_m", "depth_m"],
            "properties": {"type": {"$ref": "#/$defs/frame"}, "parts": {"type": "array", "minItems": 1}}},
  "glass_tint": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 4, "maxItems": 4},
  "glass": {"type": "object", "required": ["id", "name_de", "srgb", "alpha", "parts", "catalog"],
            "properties": {"id": {"$ref": "#/$defs/tint"}, "srgb": {"$ref": "#/$defs/hex"}, "parts": {"type": "array", "minItems": 1}}},
  "tube": {"type": ["object", "null"], "required": ["length_m", "lens_radius_m", "eye_radius_m", "bore_radius_m", "eye_anchor"],
           "properties": {"eye_anchor": {"const": "Socket_Eye"}, "length_m": {"type": "number", "minimum": 0}, "lens_radius_m": {"type": "number", "minimum": 0}}},
  "module": {"type": ["object", "null"], "required": ["id", "name_de", "side", "parts", "bounds_m"],
             "properties": {"id": {"enum": ["night_vision", "rangefinder", "target_marker", "wind_compensation"]}, "side": {"enum": ["left", "right", "top"]}}},
  "anchors": {"type": "object", "required": ["Socket_Mount", "Socket_Sight", "Socket_Reticle", "Socket_Eye"],
              "properties": {"Socket_Mount": {"$ref": "#/$defs/anchor"}, "Socket_Sight": {"$ref": "#/$defs/anchor"}, "Socket_Reticle": {"$ref": "#/$defs/anchor"},
                             "Socket_Eye": {"type": ["object", "null"]}}},
  "sight_line": {"type": "object", "required": ["start_m", "end_m", "clear", "blocked_by", "glass_crossed"],
                 "properties": {"clear": {"const": true}, "blocked_by": {"type": "array", "maxItems": 0}, "glass_crossed": {"type": "array", "minItems": 1}}},
  "window_geometry": {"type": "object", "required": ["elements"], "properties": {"elements": {"type": "array", "minItems": 1}}},
  "parts": {"type": "array", "minItems": 1, "items": {"type": "object",
            "required": ["id", "label", "channel", "material", "toolgen_material", "emissive", "glass", "color", "area_m2", "bounds_m"],
            "properties": {"id": {"type": "string", "pattern": "^g[0-9]{2}$"}, "channel": {"$ref": "#/$defs/channel"},
                           "material": {"enum": ["painted", "brushed", "rubber", "matte", "lit", "glass"]},
                           "toolgen_material": {"type": ["string", "null"]}, "emissive": {"type": "boolean"}, "glass": {"type": "boolean"},
                           "color": {"$ref": "#/$defs/hex"}, "bounds_m": {"$ref": "#/$defs/bounds"}}}},
  "reticle_variants": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["id", "name_de", "default"]}},
  "reticle_color": {"$ref": "#/$defs/hex"},
  "variants": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["id", "name_de", "channels", "glass_tint"],
               "properties": {"glass_tint": {"$ref": "#/$defs/tint"}}}},
  "source": {"type": "object", "required": ["images", "table", "decisions"]}
 }
}
