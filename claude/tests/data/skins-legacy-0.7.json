  "rennstreifen": [
   "zwei Rennstreifen in Akzentfarbe über die Oberseite, Seitenband mit weißer Zierlinie, große schräge Segmentnummer, Läufe poliertes Chrom, leichte Kantenabnutzung",
   "two accent racing stripes over the top, side band with white pinstripe, large slanted segment number, polished chrome barrels, light edge wear"
  ],
  "goldglyphe": [
   "dunkles Gehäuse, poliertes Gold an Läufen und Mündung, goldene Runenzeile und Zierlinie, goldene Finnen, Kantenabnutzung",
   "dark body, polished gold barrels and muzzle, row of gold glyphs and gold pinstripe, gold fins, edge wear"
  ],
  "warnblock": [
   "gelb-schwarze Warnstreifen vorn, Heckblock in Zweitfarbe, Winkel-Emblem mit Nummer, starke Kantenabnutzung",
   "yellow-black hazard stripes at the front, rear block in secondary color, chevron emblem with number, heavy edge wear"
  ],
  "zweiton": [
   "diagonale Zweifarb-Teilung mit Akzentlinie, Würfel-Emblem, Chrom an Läufen",
   "diagonal two-tone split with accent line, cube emblem, chrome barrels"
  ],
  "stufenblock": [
   "gestufte Farbblöcke dunkel unter hell, Gold an Metallteilen, goldene Rippen, Segmentnummer",
   "stepped color blocks dark below light, gold metal parts, gold ribs, segment number"
  ],
  "zielringe": [
   "konzentrische Ringe in Akzentfarbe und Weiß auf der Seite, kleine Runen, Chrom an Läufen",
   "concentric accent and white rings on the side, small glyphs, chrome barrels"
  ],
  "glutverlauf": [
   "gestufter Farbverlauf von der Grundfarbe zur Akzentfarbe nach vorn, zwei leuchtende Neonlinien, dunkle Chromrippen",
   "stepped color gradient from base to accent toward the muzzle, two glowing neon lines, dark chrome ribs"
  ],
  "chromrippe": [
   "dunkles Gehäuse, Chromrippen an der Seite, Chromfinnen, Akzentband unten, Kantenabnutzung",
   "dark body, chrome side ribs, chrome fins, accent band along the bottom, edge wear"
  ],
  "glyphenband": [
   "dunkles Band mit leuchtender Neon-Runenzeile über die Seite, Chrom an Läufen",
   "dark side band with a glowing neon glyph row, chrome barrels"
  ]
 }
